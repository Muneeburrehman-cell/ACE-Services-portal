# ============================================================
# ESTIMATION PORTAL — Environment Configuration
# Copy this file to .env and fill in all values.
# NEVER commit .env to source control.
# ============================================================
RESEND_API_KEY=re_Qj59nXJf_Pjc2ESeQh4upWWfehPXCBamT
RESEND_FROM_EMAIL=onboarding@resend.dev

APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
ADMIN_EMAIL=georgeadam2492@gmail.com
COMPANY_NAME=ACE SERVICES
# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/portal

# ── JWT Secrets ──────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev-jwt-secret-please-change-in-production-256bits-long-enough

# ── File Storage ───────────────────────────────────────────
# Files are stored locally in the 'uploads/' directory
# No cloud storage configuration needed
UPLOAD_DIR=uploads

# ── Email Delivery (Resend) ─────────────────────────────────
# Get API key from: https://resend.com/api-keys
# For demo mode, leave RESEND_API_KEY as 'demo' to log emails to console
RESEND_API_KEY=demo
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Application ──────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
ADMIN_EMAIL=admin@portal.com
COMPANY_NAME=ACE SERVICES
NODE_ENV=development
