# ============================================================
# ESTIMATION PORTAL — Environment Configuration
# Copy this file to .env and fill in all values.
# NEVER commit .env to source control.
# ============================================================

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/portal

# ── JWT Secrets ──────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev-jwt-secret-please-change-in-production-256bits-long-enough
JWT_REFRESH_SECRET=dev-refresh-secret-please-change-in-production-256bits-ok
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email Delivery (Resend) ─────────────────────────────────
# Get API key from: https://resend.com/api-keys
# For local development, use 'demo' to log emails to console
# DO NOT COMMIT REAL API KEYS TO GIT
RESEND_API_KEY=put your api key here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── File Storage ───────────────────────────────────────────
# Files are stored locally in the 'uploads/' directory
CF_ACCOUNT_ID=demo
CF_R2_ACCESS_KEY_ID=demo
CF_R2_SECRET_ACCESS_KEY=demo
CF_R2_BUCKET=demo-local

# ── Application ──────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
ADMIN_EMAIL=admin@portal.com
COMPANY_NAME=ACE SERVICES
NODE_ENV=development

