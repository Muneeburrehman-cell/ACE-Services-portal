# ============================================================
# ESTIMATION PORTAL — Environment Configuration
# Copy this file to .env and fill in all values.
# NEVER commit .env to source control.
# ============================================================

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/portal

# ── JWT Secrets ──────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dev-jwt-secret-please-change-in-production-256bits-long-enough
JWT_REFRESH_SECRET=dev-refresh-secret-please-change-in-production-256bits-ok
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudflare R2 / S3 (file storage) ──────────────────────
# Leave as 'demo' for local disk storage (demo-uploads/)
CF_ACCOUNT_ID=demo
CF_R2_ACCESS_KEY_ID=demo
CF_R2_SECRET_ACCESS_KEY=demo
CF_R2_BUCKET=demo-local

# ── Email Delivery (Configure ANY of these for REAL emails) ─
# Option 1: Resend (Recommended)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=deliveries@yourdomain.com

# Option 2: SendGrid
# Get API key from: https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=SG.your_sendgrid_key
# SENDGRID_FROM_EMAIL=deliveries@yourdomain.com

# Option 3: Standard SMTP (Gmail, Outlook, Amazon SES, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=your_email@gmail.com
# SMTP_SECURE=false

# ── Application ──────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
ADMIN_EMAIL=admin@portal.com
COMPANY_NAME=ACE SERVICES
NODE_ENV=development
